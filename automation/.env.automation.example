# 이 파일을 같은 폴더에 ".env.automation" 이름으로 복사한 뒤 값을 채우세요.
# ".env.automation" 파일 자체는 git에 올라가지 않습니다 (.gitignore 처리됨).
#
# 토큰은 사이트에 로그인한 뒤 ⚙️ 설정 > "PC 연동" > "내 PC와 연결" 버튼을 눌러 발급받으세요.
# (로그인 비밀번호가 아닙니다 — 유출돼도 사이트에서 "연결 끊기"로 바로 무효화할 수 있습니다.)

SITE_URL=https://email-task-tracker-kwangmin-ryu.vercel.app
EMAIL_TASK_TOKEN=여기에_사이트에서_발급받은_토큰_붙여넣기

# claude 명령어가 PATH에 없다면 전체 경로를 적어주세요 (예: C:\Users\me\AppData\Roaming\npm\claude.cmd)
CLAUDE_CMD=claude
